PORT=3001
HOST=127.0.0.1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Optional: when configured, the local API uses this hosted OpenAI-compatible provider instead of Ollama.
# Keep secrets in backend/.env (never in VITE_* variables).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Defina TRUST_PROXY=true somente se o proxy remover cabeçalhos encaminhados enviados pelo cliente.
# TRUST_PROXY=true
# Opcional para acesso direto entre domínios. Para produção, liste apenas a origem pública do frontend.
# CORS_ORIGIN=https://mindly.example.com
